# Development evidence stays in Git, not source distributions.
/.specstory export-ignore
/.specstory/** export-ignore
/.claude/plans export-ignore
/.claude/plans/** export-ignore
/.codex/plans export-ignore
/.codex/plans/** export-ignore
/.cursor/plans export-ignore
/.cursor/plans/** export-ignore
/.opencode/plans export-ignore
/.opencode/plans/** export-ignore

# Embedded scripts, skills and checksum fixtures must retain Git's LF bytes on Windows.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
